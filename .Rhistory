setwd("~/Downloads/portfolio")
setwd("~/Downloads/portfolio")
setwd("~/Downloads/portfolio")
tidy(model_improved, exponentiate = TRUE, conf.int = TRUE) %>%
filter(term != "(Intercept)") %>%
mutate(across(where(is.numeric), ~ round(., 4))) %>%
arrange(p.value) %>%
kable(
caption = "Improved Logistic Regression: Odds Ratios",
col.names = c(
"Predictor", "Odds Ratio", "Std. Error", "Statistic",
"p-value", "CI Lower", "CI Upper"
)
) %>%
kable_styling(
bootstrap_options = c("striped", "hover", "condensed"),
full_width = FALSE
)
